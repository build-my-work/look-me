---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import SiteHeader from "../../../../components/SiteHeader.astro";
import SiteFooter from "../../../../components/SiteFooter.astro";
import TwentyTimer from "../../../../components/TwentyTimer.astro";
import DownloadCta from "../../../../components/DownloadCta.astro";
import { breadcrumbSchema, languageAlternates } from "../../../../lib/site";

const path = "/zh-cn/tools/20-20-20-timer/";
const title = "免费 20-20-20 护眼计时器｜20 分钟看屏与 20 秒远眺";
const description = "在浏览器里免费使用 20-20-20 计时器：看屏 20 分钟后，远眺约 6 米外 20 秒。不用安装、不用账号，不调用摄像头，也不包含分析脚本。";
---

<BaseLayout
  title={title}
  description={description}
  path={path}
  locale="zh-CN"
  alternates={languageAlternates("/tools/20-20-20-timer/", path)}
  schemas={[
    breadcrumbSchema([
      { name: "首页", path: "/zh-cn/" },
      { name: "20-20-20 护眼法", path: "/zh-cn/20-20-20-rule/" },
      { name: "免费计时器", path },
    ]),
  ]}
>
  <SiteHeader locale="zh-CN" currentPath={path} alternatePath="/tools/20-20-20-timer/" />
  <main id="main-content">
    <header class="page-hero shell-narrow">
      <p class="eyebrow">免费 · 不用安装 · 在当前标签页运行</p>
      <h1>开始一次 20 分钟看屏计时。</h1>
      <p>计时结束后，Lumi 会保留 20 秒远眺时间。状态只存在当前标签页的 session storage，不会发送到服务器。</p>
    </header>

    <div class="shell-narrow">
      <TwentyTimer locale="zh-CN" />

      <article class="article-body">
        <h2>怎样使用</h2>
        <ol>
          <li>开始看屏时，点击<strong>开始 20 分钟计时</strong>。</li>
          <li>保持标签页打开。你也可以允许浏览器在远眺开始时发送通知。</li>
          <li>20 秒休息期间，看向约 6 米外的真实物体。</li>
          <li>远眺结束后，下一轮 20 分钟会自动开始。</li>
        </ol>

        <div class="article-callout">
          <strong>网页计时器不会调用摄像头</strong>
          <p>页面没有分析脚本。计时状态只保存在当前浏览器标签页的 session storage 中。</p>
        </div>

        <h2>桌面版可以按实际看屏时间推进</h2>
        <p>Lumi 桌面版在人脸信号不可用时暂停看屏计时。摄像头画面在本机处理，并立即丢弃。</p>
        <p><a class="text-link" href="/zh-cn/how-it-works/">查看桌面版的检测流程<span aria-hidden="true"> →</span></a></p>

        <h2>了解 20-20-20 的适用边界</h2>
        <p>20-20-20 是一般屏幕休息建议，不是治疗或诊断方法。完整指南列出了来源、限制和需要专业检查的情况。</p>
        <p><a class="text-link" href="/zh-cn/20-20-20-rule/">阅读 20-20-20 指南<span aria-hidden="true"> →</span></a></p>
      </article>
    </div>

    <DownloadCta locale="zh-CN" />
  </main>
  <SiteFooter locale="zh-CN" />
</BaseLayout>
