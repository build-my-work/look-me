---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import SiteHeader from "../../../components/SiteHeader.astro";
import SiteFooter from "../../../components/SiteFooter.astro";
import { breadcrumbSchema, chineseSoftwareApplicationSchema, languageAlternates, SITE } from "../../../lib/site";

const path = "/zh-cn/download/";
const title = "下载 Lumi 眨眼提醒｜macOS、Windows 与 Linux";
const description = "免费下载 Lumi 眨眼提醒预览版，支持 macOS、Windows 和 Linux。安装前可查看系统要求、本机摄像头处理方式，以及当前安装包尚未签名的说明。";
---

<BaseLayout
  title={title}
  description={description}
  path={path}
  locale="zh-CN"
  alternates={languageAlternates("/download/", path)}
  schemas={[
    chineseSoftwareApplicationSchema,
    breadcrumbSchema([{ name: "首页", path: "/zh-cn/" }, { name: "下载", path }]),
  ]}
>
  <SiteHeader locale="zh-CN" currentPath={path} alternatePath="/download/" />
  <main id="main-content">
    <header class="page-hero shell">
      <p class="eyebrow">免费预览版 · 开源</p>
      <h1>下载适合你电脑的 Lumi 安装包。</h1>
      <p>三个系统的安装包来自同一个公开仓库。当前版本尚未签名，安装前请阅读对应平台的提示。</p>
    </header>

    <section class="platform-grid" aria-label="可下载平台">
      <article class="platform-card">
        <p class="eyebrow">APPLE SILICON · INTEL</p>
        <h2>macOS 12+</h2>
        <p>提供 arm64 和 x64 的 DMG。开始监测时，macOS 会询问摄像头权限。</p>
        <a class="text-link" href="/mac-eye-break-reminder/" hreflang="en">macOS 安装说明（英文）<span aria-hidden="true"> →</span></a>
      </article>
      <article class="platform-card">
        <p class="eyebrow">64 位</p>
        <h2>Windows 10+</h2>
        <p>提供 x64 EXE 安装包。未签名预览版可能触发 SmartScreen 提示。</p>
        <a class="text-link" href="/windows-eye-break-reminder/" hreflang="en">Windows 安装说明（英文）<span aria-hidden="true"> →</span></a>
      </article>
      <article class="platform-card">
        <p class="eyebrow">APPIMAGE · DEB</p>
        <h2>Linux x64</h2>
        <p>提供 AppImage 和 Debian 安装包，不同桌面环境的托盘与窗口行为可能不同。</p>
        <a class="text-link" href="/linux-eye-break-reminder/" hreflang="en">Linux 安装说明（英文）<span aria-hidden="true"> →</span></a>
      </article>
    </section>

    <section class="section-tight section-tint">
      <div class="shell-narrow article-body">
        <p class="eyebrow">官方下载</p>
        <h2>从 GitHub Releases 获取最新版本</h2>
        <p>选择与你的操作系统和处理器架构匹配的文件。发布流程提供校验值时，也会显示在 Release 页面中。</p>
        <p><a class="button" href={SITE.releases} target="_blank" rel="noreferrer">打开 GitHub Releases</a></p>

        <div class="status-banner"><strong>未签名预览版：</strong>Lumi 还没有完成 macOS 公证和 Windows 代码签名，系统出现安全提示属于当前限制。不要从镜像站或不相关的网站下载安装包。</div>

        <h2>第一次启动会发生什么</h2>
        <p>应用会打开桌面上的 Lumi 和本地状态面板。眨眼与坐姿检测需要摄像头权限。权限被拒绝或人脸信号不可用时，这些功能会暂停。</p>

        <h2>先查看源代码</h2>
        <p>公开仓库包含 Electron 主进程、React 界面、测试、打包配置和发布流程。你可以在运行预览版前自行检查。</p>
        <p><a class="text-link" href={SITE.repository} target="_blank" rel="noreferrer">在 GitHub 查看源代码<span aria-hidden="true"> →</span></a></p>
      </div>
    </section>
  </main>
  <SiteFooter locale="zh-CN" />
</BaseLayout>
