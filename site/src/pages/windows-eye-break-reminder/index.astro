<PlatformLanding
  platform="Windows"
  path="/windows-eye-break-reminder/"
  title="Eye Break & Blink Reminder for Windows | Look Me"
  description="Look Me runs from the Windows system tray and places a small desktop companion over your workspace while processing blink and posture signals locally."
  packageLabel="Windows installer"
  requirements="64-bit Windows 10 or later."
  steps={[
    "Open the latest GitHub Release and download the Windows x64 EXE installer.",
    "Run the installer and review any Windows SmartScreen message before continuing.",
    "Launch Look Me and grant camera access only if you want context-aware monitoring.",
    "Use the tray icon to configure the companion, reminder switches, and monitoring schedule.",
  ]}
  warning="The Windows installer is not currently code-signed and may trigger SmartScreen. Verify that the publisher URL is the official Look Me GitHub repository before running it."
/>
