---
import PlatformLanding from "../../components/PlatformLanding.astro";
---

<PlatformLanding
  platform="macOS"
  path="/mac-eye-break-reminder/"
  title="Eye Break & Blink Reminder for Mac | Look Me"
  description="Look Me lives in the macOS menu bar and as a small transparent desktop companion, with local blink, distance-break, and sedentary reminders."
  packageLabel="DMG for your Mac"
  requirements="macOS 12 or later; separate Apple silicon and Intel builds are available."
  steps={[
    "Open the latest GitHub Release and download the macOS DMG matching Apple silicon (arm64) or Intel (x64).",
    "Open the DMG and move Look Me to Applications.",
    "Launch Look Me and review the macOS camera permission prompt. Monitoring remains off when camera permission is unavailable.",
    "Use the menu-bar icon to configure the companion, reminder switches, and monitoring schedule.",
  ]}
  warning="Current direct-download builds are not yet signed or notarized. macOS may block the first launch; only continue if you downloaded the release from the official GitHub repository and understand this limitation."
/>
