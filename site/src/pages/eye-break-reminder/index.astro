---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import DownloadCta from "../../components/DownloadCta.astro";
import { breadcrumbSchema, softwareApplicationSchema } from "../../lib/site";

const path = "/eye-break-reminder/";
const title = "Eye Break Reminder for Desktop | Lumi";
const description = "A private eye break reminder for Mac, Windows, and Linux that follows observed screen sessions and guides 20-second distance breaks.";
---

<BaseLayout
  title={title}
  description={description}
  path={path}
  schemas={[
    softwareApplicationSchema,
    breadcrumbSchema([{ name: "Home", path: "/" }, { name: "Eye break reminder", path }]),
  ]}
>
  <SiteHeader currentPath={path} />
  <main id="main-content">
    <header class="page-hero shell">
      <p class="eyebrow">EYE BREAK REMINDER FOR DESKTOP</p>
      <h1>Lumi counts observed screen time and pauses when you leave.</h1>
      <p>While monitoring is active, Lumi accumulates screen time when a usable face signal is present. After 20 minutes, it opens a 20-second distance break with a clear skip button.</p>
      <div class="hero-actions">
        <a class="button" href="/download/">Download Lumi</a>
        <a class="button button-secondary" href="/tools/20-20-20-timer/">Try the browser timer</a>
      </div>
    </header>

    <section class="section-tight" aria-labelledby="flow-heading">
      <div class="shell">
        <div class="section-heading">
          <div><p class="eyebrow">THE DISTANCE-BREAK FLOW</p><h2 id="flow-heading">What happens during a distance-break cycle.</h2></div>
          <p>The distance reminder is independent from blink and sedentary reminders. Disable it without changing the rest of the app.</p>
        </div>
        <div class="steps-grid">
          <article class="step-card"><strong>Observe</strong><p>Eligible screen time accumulates while a usable face signal is present within your monitoring schedule.</p></article>
          <article class="step-card"><strong>Invite</strong><p>At 20 minutes, a lightweight horizon asks you to look at a distant object for 20 seconds.</p></article>
          <article class="step-card"><strong>Resume</strong><p>Finish or skip the break, then return to work. Locking the computer or pausing monitoring releases the camera.</p></article>
        </div>
      </div>
    </section>

    <section class="section" aria-labelledby="horizon-heading">
      <div class="shell horizon-panel">
        <img src="/assets/horizon-break.webp" width="1400" height="420" alt="A quiet distant landscape used during the 20-second eye break" />
        <div class="horizon-copy">
          <p class="eyebrow">THE BREAK VIEW</p>
          <h2 id="horizon-heading">Look past the illustration at a real distant object.</h2>
          <p>The illustration keeps time. During the 20 seconds, look at an object about 20 feet or six metres away.</p>
          <a class="text-link" href="/20-20-20-rule/">Read the sourced 20-20-20 guide<span aria-hidden="true"> →</span></a>
        </div>
      </div>
    </section>

    <section class="section section-tint" aria-labelledby="limits-heading">
      <div class="shell-narrow article-body">
        <p class="eyebrow">WHAT IT DOES NOT DO</p>
        <h2 id="limits-heading">An eye-break reminder cannot examine your eyes.</h2>
        <p>Lumi supports a general screen-break habit. It does not diagnose digital eye strain or dry eye disease, measure viewing distance, determine whether a prescription is correct, or recommend treatment.</p>
        <p>If symptoms persist, worsen, or include significant pain, redness, light sensitivity, discharge, injury, or sudden visual change, seek professional eye care.</p>
      </div>
    </section>

    <DownloadCta />
  </main>
  <SiteFooter />
</BaseLayout>
