---
interface Source {
  title: string;
  publisher: string;
  href: string;
}

interface Props {
  sources: Source[];
  locale?: "en" | "zh-CN";
}

const { sources, locale = "en" } = Astro.props;
const isChinese = locale === "zh-CN";
---

<aside class="sources" aria-labelledby="sources-heading">
  <h2 id="sources-heading">{isChinese ? "参考资料" : "Sources and further reading"}</h2>
  <ol>
    {sources.map((source) => (
      <li><a href={source.href} target="_blank" rel="noreferrer">{source.title}</a><span>{source.publisher}</span></li>
    ))}
  </ol>
  <p>{isChinese ? "本文根据以上资料整理，仅用于一般信息参考，未经医疗专业人员审阅，不能代替诊断或治疗建议。" : "This page summarizes the sources above for general information. It has not been reviewed by a medical professional and cannot replace professional care."}</p>
</aside>
