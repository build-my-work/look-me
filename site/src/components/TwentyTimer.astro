---
import type { Locale } from "../lib/site";

interface Props {
  locale?: Locale;
}

const { locale = "en" } = Astro.props;
const isChinese = locale === "zh-CN";
const copy = isChinese
  ? {
      heading: "免费 20-20-20 网页计时器",
      ready: "准备开始",
      initialMessage: "开始看屏时启动计时。",
      start: "开始 20 分钟计时",
      pause: "暂停",
      reset: "重置",
      preview: "预览 20 秒远眺",
      notifications: "开启浏览器通知",
    }
  : {
      heading: "Free 20-20-20 browser timer",
      ready: "Ready",
      initialMessage: "Start when you begin a focused screen session.",
      start: "Start 20-minute cycle",
      pause: "Pause",
      reset: "Reset",
      preview: "Preview 20-second break",
      notifications: "Enable notifications",
    };
---

<section class="timer-shell" data-twenty-timer data-locale={locale} aria-labelledby="timer-heading">
  <div class="timer-topline">
    <span id="timer-heading">{copy.heading}</span>
    <span class="timer-state" data-timer-state>{copy.ready}</span>
  </div>
  <div class="timer-body">
    <div>
      <div class="timer-display" data-timer-display aria-live="off">20:00</div>
      <p class="timer-message" data-timer-message aria-live="polite">{copy.initialMessage}</p>
    </div>
    <div class="timer-cat" aria-hidden="true">
      <img src="/assets/cat-idle-384.webp" width="384" height="480" alt="" />
    </div>
  </div>
  <div class="timer-progress" aria-hidden="true"><span data-timer-progress></span></div>
  <div class="timer-controls">
    <button type="button" data-timer-start>{copy.start}</button>
    <button type="button" data-timer-pause hidden>{copy.pause}</button>
    <button type="button" data-timer-reset>{copy.reset}</button>
    <button type="button" data-timer-preview>{copy.preview}</button>
    <button type="button" data-timer-notifications hidden>{copy.notifications}</button>
  </div>
</section>

<script>
  const root = document.querySelector<HTMLElement>("[data-twenty-timer]");

  if (root) {
    const isChinese = root.dataset.locale === "zh-CN";
    const copy = isChinese
      ? {
          notificationTitle: "看远处 20 秒",
          notificationBody: "找一个大约 6 米外的物体，Lumi 会帮你计时。",
          ready: "准备开始",
          breakState: "远眺休息",
          focusState: "看屏计时",
          breakMessage: "看向大约 6 米外的物体，让眼睛暂停近距离聚焦。",
          focusMessage: "继续当前任务。20 分钟后会提醒你远眺 20 秒。",
          initialMessage: "开始看屏时启动计时。",
          lookAway: "看远处",
          focus: "看屏",
          notificationDenied: "浏览器已阻止通知",
          notifications: "开启浏览器通知",
        }
      : {
          notificationTitle: "Look away for 20 seconds",
          notificationBody: "Find something about 20 feet (6 metres) away. Lumi will keep time.",
          ready: "Ready",
          breakState: "Distance break",
          focusState: "Focus session",
          breakMessage: "Look at something about 20 feet (6 metres) away. Let your near focus rest.",
          focusMessage: "Keep working. The timer will invite a 20-second distance break.",
          initialMessage: "Start when you begin a focused screen session.",
          lookAway: "Look away",
          focus: "Focus",
          notificationDenied: "Notifications blocked by browser",
          notifications: "Enable notifications",
        };
    const WORK_MS = 20 * 60 * 1000;
    const BREAK_MS = 20 * 1000;
    const STORAGE_KEY = "look-me:20-20-20-timer:v1";
    const defaultPageTitle = document.title;
    const display = root.querySelector<HTMLElement>("[data-timer-display]");
    const message = root.querySelector<HTMLElement>("[data-timer-message]");
    const stateLabel = root.querySelector<HTMLElement>("[data-timer-state]");
    const progress = root.querySelector<HTMLElement>("[data-timer-progress]");
    const startButton = root.querySelector<HTMLButtonElement>("[data-timer-start]");
    const pauseButton = root.querySelector<HTMLButtonElement>("[data-timer-pause]");
    const resetButton = root.querySelector<HTMLButtonElement>("[data-timer-reset]");
    const previewButton = root.querySelector<HTMLButtonElement>("[data-timer-preview]");
    const notificationButton = root.querySelector<HTMLButtonElement>("[data-timer-notifications]");

    type Mode = "work" | "break";
    interface TimerState {
      mode: Mode;
      running: boolean;
      remaining: number;
      endAt: number | null;
    }

    let timer: TimerState = {
      mode: "work",
      running: false,
      remaining: WORK_MS,
      endAt: null,
    };
    let intervalId: number | null = null;

    const saved = sessionStorage.getItem(STORAGE_KEY);
    if (saved) {
      try {
        const parsed = JSON.parse(saved) as Partial<TimerState>;
        if ((parsed.mode === "work" || parsed.mode === "break") && typeof parsed.running === "boolean") {
          timer = {
            mode: parsed.mode,
            running: parsed.running,
            remaining: typeof parsed.remaining === "number" ? parsed.remaining : WORK_MS,
            endAt: typeof parsed.endAt === "number" ? parsed.endAt : null,
          };
        }
      } catch {
        sessionStorage.removeItem(STORAGE_KEY);
      }
    }

    const durationForMode = () => timer.mode === "work" ? WORK_MS : BREAK_MS;

    const persist = () => sessionStorage.setItem(STORAGE_KEY, JSON.stringify(timer));

    const notify = () => {
      if ("Notification" in window && Notification.permission === "granted") {
        new Notification(copy.notificationTitle, {
          body: copy.notificationBody,
          icon: "/assets/icon-192.png",
        });
      }
    };

    const formatTime = (milliseconds: number) => {
      const totalSeconds = Math.max(0, Math.ceil(milliseconds / 1000));
      const minutes = Math.floor(totalSeconds / 60);
      const seconds = totalSeconds % 60;
      return `${String(minutes).padStart(2, "0")}:${String(seconds).padStart(2, "0")}`;
    };

    const render = () => {
      if (!display || !message || !stateLabel || !progress || !startButton || !pauseButton) return;
      const value = formatTime(timer.remaining);
      display.textContent = value;
      stateLabel.textContent = timer.mode === "break" ? copy.breakState : timer.running ? copy.focusState : copy.ready;
      message.textContent = timer.mode === "break"
        ? copy.breakMessage
        : timer.running
          ? copy.focusMessage
          : copy.initialMessage;
      progress.style.transform = `scaleX(${Math.max(0, Math.min(1, timer.remaining / durationForMode()))})`;
      startButton.hidden = timer.running;
      pauseButton.hidden = !timer.running;
      document.title = timer.running ? `${value} · ${timer.mode === "break" ? copy.lookAway : copy.focus} · Lumi` : defaultPageTitle;
      persist();
    };

    const startInterval = () => {
      if (intervalId !== null) window.clearInterval(intervalId);
      intervalId = window.setInterval(tick, 250);
    };

    const advanceMode = () => {
      timer.mode = timer.mode === "work" ? "break" : "work";
      timer.remaining = durationForMode();
      timer.endAt = Date.now() + timer.remaining;
      if (timer.mode === "break") notify();
    };

    function tick() {
      if (!timer.running || timer.endAt === null) return;
      timer.remaining = Math.max(0, timer.endAt - Date.now());
      if (timer.remaining === 0) advanceMode();
      render();
    }

    const start = () => {
      timer.running = true;
      timer.endAt = Date.now() + timer.remaining;
      startInterval();
      render();
    };

    startButton?.addEventListener("click", start);
    pauseButton?.addEventListener("click", () => {
      if (timer.endAt !== null) timer.remaining = Math.max(0, timer.endAt - Date.now());
      timer.running = false;
      timer.endAt = null;
      render();
    });
    resetButton?.addEventListener("click", () => {
      timer = { mode: "work", running: false, remaining: WORK_MS, endAt: null };
      render();
    });
    previewButton?.addEventListener("click", () => {
      timer = { mode: "break", running: true, remaining: BREAK_MS, endAt: Date.now() + BREAK_MS };
      startInterval();
      render();
    });

    if (notificationButton && "Notification" in window) {
      notificationButton.hidden = Notification.permission === "granted";
      notificationButton.addEventListener("click", async () => {
        const permission = await Notification.requestPermission();
        notificationButton.hidden = permission === "granted";
        notificationButton.textContent = permission === "denied" ? copy.notificationDenied : copy.notifications;
      });
    }

    if (timer.running && timer.endAt !== null) {
      startInterval();
      tick();
    } else {
      render();
    }
  }
</script>
