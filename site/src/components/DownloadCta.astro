---
import { SITE, type Locale } from "../lib/site";

interface Props {
  locale?: Locale;
  compact?: boolean;
}

const { locale = "en", compact = false } = Astro.props;
const isChinese = locale === "zh-CN";
---

<section class:list={["download-cta", { compact }]} id={isChinese ? "download" : undefined}>
  <div>
    <p class="eyebrow">{isChinese ? "MACOS · WINDOWS · LINUX" : "MACOS · WINDOWS · LINUX"}</p>
    <h2>{isChinese ? "下载 Lumi 到电脑上" : "Download Lumi for your desktop."}</h2>
    <p>{isChinese ? "免费、开源。眨眼检测在本机运行，当前预览安装包通过 GitHub Releases 分发。" : "Free and open source. Blink detection runs on your device. Preview builds are distributed through GitHub Releases."}</p>
  </div>
  <div class="download-actions">
    <a class="button" href={SITE.releases} target="_blank" rel="noreferrer">{isChinese ? "获取最新版本" : "Get the latest release"}</a>
    <a class="text-link" href={isChinese ? "/zh-cn/download/" : "/download/"}>{isChinese ? "查看安装说明" : "Installation notes"}<span aria-hidden="true"> →</span></a>
  </div>
</section>
