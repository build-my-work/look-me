---
interface Props {
  eyebrow: string;
  title: string;
  description: string;
  updated?: string;
}

const { eyebrow, title, description, updated = "August 25, 2026" } = Astro.props;
---

<header class="article-hero shell-narrow">
  <p class="eyebrow">{eyebrow}</p>
  <h1>{title}</h1>
  <p class="article-dek">{description}</p>
  <div class="article-byline">
    <span>By Look Me</span>
    <span>Source-checked against primary eye-care guidance</span>
    <time datetime="2026-08-25">Updated {updated}</time>
  </div>
</header>
