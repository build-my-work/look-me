---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "./SiteHeader.astro";
import SiteFooter from "./SiteFooter.astro";
import DownloadCta from "./DownloadCta.astro";
import { breadcrumbSchema, softwareApplicationSchema } from "../lib/site";

interface Props {
  platform: string;
  path: string;
  title: string;
  description: string;
  packageLabel: string;
  requirements: string;
  steps: string[];
  warning: string;
}

const { platform, path, title, description, packageLabel, requirements, steps, warning } = Astro.props;
---

<BaseLayout
  title={title}
  description={description}
  path={path}
  schemas={[
    softwareApplicationSchema,
    breadcrumbSchema([{ name: "Home", path: "/" }, { name: `${platform} download`, path }]),
  ]}
>
  <SiteHeader currentPath={path} />
  <main id="main-content">
    <header class="page-hero shell">
      <p class="eyebrow">LOOK ME FOR {platform.toUpperCase()}</p>
      <h1>A context-aware eye break companion for {platform}.</h1>
      <p>{description}</p>
      <div class="hero-actions">
        <a class="button" href="https://github.com/build-my-work/look-me/releases/latest" target="_blank" rel="noreferrer">Download from GitHub</a>
        <a class="button button-secondary" href="/how-it-works/">See how sensing works</a>
      </div>
    </header>

    <section class="section-tight" aria-labelledby="install-heading">
      <div class="shell-narrow article-body">
        <p class="eyebrow">INSTALLATION</p>
        <h2 id="install-heading">Choose the {packageLabel} package.</h2>
        <p><strong>System requirement:</strong> {requirements}</p>
        <ol class="install-steps">
          {steps.map((step) => <li>{step}</li>)}
        </ol>
        <div class="status-banner"><strong>Preview-build notice:</strong> {warning}</div>

        <h2>What stays on your computer</h2>
        <p>Camera frames are processed in memory with MediaPipe and discarded. The app stores a 30-day local timeline of small behavior events in IndexedDB. It does not upload photos or video, capture your screen, or require an account.</p>

        <h2>What the app can remind you about</h2>
        <ul>
          <li>A prolonged gap between detected complete blinks.</li>
          <li>A 20-second distance break after 20 minutes of observed screen time.</li>
          <li>A configurable sedentary interval between 1 and 600 minutes.</li>
        </ul>

        <div class="article-callout">
          <strong>Not a medical device</strong>
          <p>Look Me supports screen habits. It does not diagnose digital eye strain or dry eye disease and does not replace professional eye care.</p>
        </div>
      </div>
    </section>

    <DownloadCta />
  </main>
  <SiteFooter />
</BaseLayout>
