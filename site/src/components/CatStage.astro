---
import type { Locale } from "../lib/site";

interface Props {
  locale?: Locale;
}

const { locale = "en" } = Astro.props;
const isChinese = locale === "zh-CN";
---

<figure class="desktop-stage" aria-labelledby="stage-caption">
  <div class="stage-chrome" aria-hidden="true"><i></i><i></i><i></i><span>{isChinese ? "专注时段 · 本机" : "Focus session · on this device"}</span></div>
  <img
    class="stage-workspace"
    src="/assets/preview-workspace.webp"
    width="1440"
    height="1024"
    alt=""
    fetchpriority="high"
  />
  <div class="stage-session-card">
    <span class="status-dot"></span>
    <small>{isChinese ? "近 1 分钟眨眼" : "Blinks · last minute"}</small>
    <strong>14 <em>{isChinese ? "次/分" : "/ min"}</em></strong>
    <div><span>{isChinese ? "有效看屏" : "Screen time"}</span><b>12:41</b></div>
  </div>
  <div class="stage-reminder">
    <span class="reminder-orbit" aria-hidden="true">20</span>
    <p><strong>{isChinese ? "看看远处" : "Look into the distance"}</strong><small>{isChinese ? "还剩 12 秒" : "12 seconds left"}</small></p>
  </div>
  <div class="stage-cat" aria-hidden="true">
    <img class="stage-cat-base" src="/assets/cat-idle-384.webp" width="384" height="480" alt="" />
    <img class="stage-cat-blink" src="/assets/cat-blink-384.webp" width="384" height="480" alt="" />
  </div>
  <figcaption id="stage-caption">{isChinese ? "产品情境示意：猫咪在桌面角落陪伴，并在适当时提示眨眼与远眺。" : "Product illustration: the companion stays quietly in a corner and steps in when a blink or distance break is due."}</figcaption>
</figure>
